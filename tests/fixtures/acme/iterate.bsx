<!--
The acme workspace's loop under the mock provider: a session of the loop
thread, `templates/LoopThread.bsx`, taking three turns of `eval/next`, each
decision a post of the loop thread and each unit requested of the role's
route spawned by it, every agent scripted, so a run needs no network:

    just cli --entry=<a copy of this directory>/iterate.bsx iterate

Each role also runs by hand, ie `.. --entry=<copy>/iterate.bsx write product`,
the clerk, builder and coach each continuing their thread about one target
and the grader judging fresh every time.

Run it against a copy, since the roles write the workspace: the clerk answers
the pricing ask in `docs/product.md`, the grader grades the product (and is
refused once, on a write its tools do not hold, and once on a quote the page
does not hold), and the builder fills the course's business plan into `dist/`.
The coach holds a sitting on a claim once the register holds a fatal one at
evidence 0 or 1, ie `.. --entry=<copy>/iterate.bsx coach <claim id>`.
A live workspace's entry is this one with `{ModelStreamer{provider:OpenAi}}`
for each mock and `{UserInput}` for the owner, under a server with a surface
to type into.
-->
<CliServer {CallOnReady}>
<Router {(RequestLogger, HelpHandler, JsonTableStore{path:"packages/acme/assets/threads"})}>
	<Route path="eval"><EvalRoutes/></Route>
	<Route path="check"><CheckRoutes/></Route>
	<!-- the roles: each request a thread of its own for the unit it names -->
	<Route path="write/:document" {ThreadRoute{source:Document("templates/ClerkThread.bsx"), message:"write {document}"}}/>
	<Route path="grade/:document" {ThreadRoute{source:Document("templates/GraderThread.bsx"), message:"grade {document}"}}/>
	<Route path="build/*rubric" {ThreadRoute{source:Document("templates/BuilderThread.bsx"), message:"build {rubric}"}}/>
	<Route path="coach/:claim" {ThreadRoute{source:Document("templates/CoachThread.bsx"), message:"coach {claim}"}}/>
	<!-- the loop: one unit of work a turn, the one `eval/next` names, the
	run a session of the workspace's journal of decisions -->
	<Route path="iterate" {ThreadRoute{source:Document("templates/LoopThread.bsx")}}/>
</Router>
</CliServer>
